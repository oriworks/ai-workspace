# Configuração do cluster local k3d

# Todos os serviços expostos no Gateway são subdomínios de DOMAIN
DOMAIN=develop.switch-ctrl.com

CLUSTER_NAME="oriworks"
KUBE_CONTEXT=k3d-${CLUSTER_NAME}

CLUSTER_SERVERS=1
CLUSTER_AGENTS=2

# Não passa pelo Gateway e só liga em 127.0.0.1, por isso não usa DOMAIN
REGISTRY_NAME=registry.oriworks.local
REGISTRY_CONTAINER=k3d-${REGISTRY_NAME}
REGISTRY_PORT=5000

GATEWAY_API_VERSION=v1.6.2
TRAEFIK_CHART_VERSION=41.7.1
CERT_MANAGER_CHART_VERSION=v1.21.3

# Let's Encrypt (DNS-01 via Cloudflare): letsencrypt-staging | letsencrypt-prod
ACME_EMAIL=joelviegasoliveira@gmail.com
ACME_ISSUER=letsencrypt-prod

# Fixada pelo beads
DOLT_VERSION=2.2.0
